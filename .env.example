# 星童猫咪 · 环境变量示例（复制为 .env.local 后填写）

# ---- 大模型（必需）：多专家 Agent 大脑 ----
# 方案 A（推荐）：千问全家桶 —— 大脑+语音+向量同走公共 DashScope，一把 Key 全管
#   KIMI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   KIMI_API_KEY=<公共 DashScope Key，与下方 DASHSCOPE_API_KEY 同一把>
#   XINGTONG_MODEL=qwen-plus
# 方案 B：Kimi agent-gw（默认）；或任何 OpenAI 兼容网关（如百炼工作区端点 + kimi-k3）
KIMI_API_KEY=
KIMI_BASE_URL=https://agent-gw.kimi.com/coding/v1
XINGTONG_MODEL=k3-agent

# ---- 微信小程序登录（无配置时本地开发走模拟登录）----
WX_APPID=
WX_SECRET=

# ---- 云端语音（可选）：阿里百炼 DashScope ----
# 一个 Key 同时启用 ASR + TTS；不配则 Web 端自动降级到浏览器本地语音
# 公共端点（推荐，/audio/speech + /audio/transcriptions 全开）：
#   DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   ASR=sensevoice-v1（或 qwen3-asr-flash），TTS=cosyvoice-v1（或 qwen3-tts-flash）
# 工作区专属端点（ws-*.maas.aliyuncs.com，不暴露 audio 路由）：
#   DASHSCOPE_BASE_URL=https://ws-xxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
#   XINGTONG_ASR_MODEL=qwen3-omni-flash（走 chat/completions 音频输入，已实测）
#   此类网关会丢弃音频输出流 → TTS 需显式置空 VOICE_TTS_API_KEY= 降级到浏览器语音
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
XINGTONG_TTS_MODEL=cosyvoice-v1
XINGTONG_TTS_VOICE=longwan
XINGTONG_ASR_MODEL=sensevoice-v1

# ---- 自部署语音（可选，量产降本/数据自主，与云端二选一或混配）----
# ASR 指向自部署 FunASR（OpenAI 兼容端点），TTS 指向自部署 CosyVoice API
# VOICE_ASR_BASE_URL=http://your-funasr:10096/v1
# VOICE_ASR_API_KEY=
# VOICE_TTS_BASE_URL=http://your-cosyvoice:50000/v1
# VOICE_TTS_API_KEY=
