# 星童猫咪 · 环境变量示例（复制为 .env.local 后填写）

# ---- 大模型（必需）：多专家 Agent 大脑 ----
KIMI_API_KEY=
KIMI_BASE_URL=https://agent-gw.kimi.com/coding/v1
XINGTONG_MODEL=k3-agent

# ---- 微信小程序登录（无配置时本地开发走模拟登录）----
WX_APPID=
WX_SECRET=

# ---- 云端语音（可选）：阿里百炼 DashScope ----
# 一个 Key 同时启用 ASR + TTS；不配则 Web 端自动降级到浏览器本地语音
DASHSCOPE_API_KEY=
XINGTONG_TTS_MODEL=cosyvoice-v1
XINGTONG_TTS_VOICE=longwan
XINGTONG_ASR_MODEL=sensevoice-v1

# ---- 自部署语音（可选，量产降本/数据自主，与云端二选一或混配）----
# ASR 指向自部署 FunASR（OpenAI 兼容端点），TTS 指向自部署 CosyVoice API
# VOICE_ASR_BASE_URL=http://your-funasr:10096/v1
# VOICE_ASR_API_KEY=
# VOICE_TTS_BASE_URL=http://your-cosyvoice:50000/v1
# VOICE_TTS_API_KEY=
