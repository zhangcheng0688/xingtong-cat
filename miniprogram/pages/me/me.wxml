<view class="page">
  <!-- 账号卡 -->
  <view class="card card-dark row" style="gap:24rpx">
    <image src="/assets/mascot.png" mode="aspectFit" style="width:100rpx;height:100rpx" />
    <view class="flex1">
      <view class="serif" style="font-size:36rpx">{{user.phone || '微信家长'}}</view>
      <view class="tiny" style="opacity:.6">星童猫咪 · 家庭干预伙伴</view>
    </view>
  </view>

  <!-- 积分卡 -->
  <view class="card mt-m row between">
    <view>
      <view class="tiny muted">我的积分</view>
      <view class="serif" style="font-size:56rpx;color:#DE911D;line-height:1.3">{{balance === null ? '…' : balance}}</view>
      <view class="tiny muted" wx:if="{{pricing}}">演练 {{pricing.scenario}} · 课程 {{pricing.lesson}} · 周报 {{pricing.weekly}} 积分</view>
    </view>
    <button class="btn btn-gold" style="width:auto;padding:0 40rpx;height:80rpx;font-size:26rpx" bindtap="todo">充值</button>
  </view>

  <!-- 星星档案 -->
  <view class="title mt-l" style="font-size:32rpx">星星档案</view>
  <view class="card mt-s" wx:if="{{profile}}">
    <view class="row" style="gap:20rpx">
      <view style="font-size:44rpx">{{profile.gender === 'boy' ? '👦' : '👧'}}</view>
      <view class="flex1">
        <view style="font-weight:600">{{profile.name}} · {{profile.age}} 岁</view>
        <view class="tiny muted">{{profile.languageLevel || '口语发展中'}}</view>
      </view>
    </view>
    <view class="small muted mt-s" wx:if="{{profile.interests}}">喜欢：{{profile.interests}}</view>
    <view class="small muted" style="margin-top:8rpx" wx:if="{{profile.behaviors}}">关注：{{profile.behaviors}}</view>
  </view>
  <view class="card mt-s center muted small" wx:else>还没有档案，请先在 Web 端建立</view>

  <!-- 功能入口 -->
  <view class="title mt-l" style="font-size:32rpx">更多</view>
  <view class="list-row" bindtap="todo"><view class="flex1">📊 每周成长周报</view><view class="arrow">→</view></view>
  <view class="list-row" bindtap="todo"><view class="flex1">✦ 积分充值</view><view class="arrow">→</view></view>
  <view class="list-row" bindtap="logout"><view class="flex1" style="color:#D4755E">退出登录</view><view class="arrow">→</view></view>

  <view class="center tiny muted mt-l">星童猫咪 · 让每一颗星星都被温柔以待</view>
</view>
